<?php
/** @var Magento\Framework\View\Element\Template $block */
/** @var Magento\Framework\Escaper $escaper */
/** @var Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp */
/** @var MageOS\MaxMindGeoipRedirect\ViewModel\Popup $viewModel */

$viewModel = $block->getViewModel();
?>
<div
    id="geoip-redirect-popup"
    class="
        geoip-redirect-popup
        fixed
        right-0
        bottom-0
        w-96
        max-w-full
        max-h-[calc(100%-120px)]
        p-4
        bg-white
        z-50
        shadow-2xl
        overflow-y-auto
        sm:max-w-sm
    "
    role="dialog"
    aria-modal="true"
    aria-labelledby="geoip-popup-title"
    x-data="geoipRedirectPopup({
        storeCode: '<?= $escaper->escapeJs($viewModel->getStoreCode()) ?>',
        checkUrl: '<?= $escaper->escapeJs($block->getUrl('maxmind/geoip/checkpopup')) ?>',
        acceptUrl: '<?= $escaper->escapeJs($block->getUrl('maxmind/geoip/redirect')) ?>',
        declineUrl: '<?= $escaper->escapeJs($block->getUrl('maxmind/geoip/decline')) ?>'
    })"
    x-init="init()"
    x-show="visible"
    x-cloak
    @keydown.escape.window="if (visible && declineUrl) { window.location.href = declineUrl; }"
    @keydown.tab.window="if (visible) { $event.preventDefault(); const focusable = $el.querySelectorAll('a, button, [tabindex]:not([tabindex=\'-1\'])'); const arr = Array.from(focusable); const idx = arr.indexOf(document.activeElement); if ($event.shiftKey) { arr[(idx - 1 + arr.length) % arr.length].focus(); } else { arr[(idx + 1) % arr.length].focus(); } }"
>
    <div class="popup-content">
        <p id="geoip-popup-title" class="geoip-message" x-html="message"></p>
        <div class="flex gap-2 mt-2">
            <a :href="acceptUrl"
               x-text="acceptLabel"
               x-ref="acceptBtn"
               class="inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium bg-blue-600 text-white hover:bg-blue-700"></a>

            <a :href="declineUrl"
               x-text="declineLabel"
               class="inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium bg-gray-200 text-gray-900 hover:bg-gray-300"></a>
        </div>
    </div>
</div>

<script>
    function geoipRedirectPopup(config) {
        return {
            visible: false,
            message: '',
            acceptLabel: 'Accept',
            declineLabel: 'Decline',
            acceptUrl: config.acceptUrl,
            declineUrl: config.declineUrl,

            init() {
                const redirectCookie = this.getCookie('maxmind_redirect');

                if (config.storeCode === redirectCookie) {
                    return;
                }

                fetch(config.checkUrl, { credentials: 'same-origin' })
                    .then(r => r.json())
                    .then(response => {
                        if (response.showPopup && response.targetStore !== redirectCookie) {
                            if (typeof response.popupText === 'string' && response.popupText.trim() !== '') {
                                this.message = response.popupText.replace('{{geolocated_country}}', response.countryName);
                            }

                            if (typeof response.acceptLabel === 'string') {
                                this.acceptLabel = response.acceptLabel;
                            }

                            if (typeof response.declineLabel === 'string') {
                                this.declineLabel = response.declineLabel;
                            }

                            this.visible = true;
                            this.$nextTick(() => {
                                this.$refs.acceptBtn && this.$refs.acceptBtn.focus();
                            });
                        }
                    });
            },

            getCookie(name) {
                const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
                return match ? decodeURIComponent(match[2]) : null;
            }
        };
    }
</script>
<?php $hyvaCsp->registerInlineScript() ?>